# 로컬 개발용. 실제 값은 .env에 (커밋 금지). 배포에선 각 서비스 환경변수에 넣는다.

# [백엔드 · Render] 음성 입력(말해서 목표 정하기)
OPENAI_API_KEY=
# OPENAI_INTENT_MODEL=
# OPENAI_TRANSCRIBE_MODEL=

# [tools/build_network.py] 서울 열린데이터광장 "실시간 지하철" 인증키
SEOUL_SUBWAY_KEY=

# [tools/seed_members.py] 회원 명부 등록용. service_role 키는 절대 프론트·깃에 넣지 말 것
