# 로컬 개발용. 실제 값은 .env에 (커밋 금지). 배포에선 Render 환경변수에 넣는다.

# [백엔드] 서울 열린데이터광장 "실시간 지하철" 인증키 (실시간 열차 위치)
SEOUL_SUBWAY_KEY=

# [백엔드] (선택) 채팅에 Claude 연결
ANTHROPIC_API_KEY=

# [백엔드] (선택, 무료) 채팅에 Gemini 연결 — https://aistudio.google.com 에서 무료 키
GEMINI_API_KEY=

# [tools/seed_members.py] 회원 명부 등록용. service_role 키는 절대 프론트·깃에 넣지 말 것
SUPABASE_URL=https://lkodieijgaegfnayrapq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
